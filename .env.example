# DZ Domain Watch — Configuration optionnelle
# Copier ce fichier en .env et ajuster les valeurs

# Chemin personnalisé vers la watchlist (optionnel)
# DZ_WATCHLIST_PATH=/chemin/vers/watchlists.json

# Chemin personnalisé vers la base SQLite (optionnel)
# DZ_DB_PATH=/chemin/vers/dz_watch.db

# Score minimum par défaut pour le collector (optionnel, défaut: 30)
# DZ_MIN_SCORE=30

# URL CertStream alternative (optionnel)
# CERTSTREAM_URL=wss://certstream.calidog.io/
