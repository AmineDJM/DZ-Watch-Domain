{
  "name": "DZ Domain Watch",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  "postCreateCommand": "pip install --use-pep517 --quiet -r requirements.txt && echo '✅ Dépendances installées'",

  "postStartCommand": "bash scripts/start.sh",

  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "DZ Domain Watch Dashboard",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
